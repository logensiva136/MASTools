# Copy this file to .env and adjust as needed.
# Docker Compose and the backend both read from .env at the repo root.

# --- Host ports ---
# Change any of these if the default is already taken on your machine
# (e.g. "port is already allocated" from Docker Desktop). These control
# only the HOST side of the mapping — containers still talk to each other
# on their normal internal ports, and the frontend's API URL / CORS origin
# are derived automatically from these in docker-compose.yml, so you only
# need to change the number here.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# --- Postgres ---
POSTGRES_USER=mastools
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mastools
POSTGRES_HOST=postgres
# Port Postgres listens on *inside* its own container — leave this at 5432
# unless you changed PGPORT; it is unrelated to POSTGRES_HOST_PORT above.
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend ---
# Full SQLAlchemy URL is assembled from the Postgres vars above if left unset.
DATABASE_URL=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=500
CATALOG_VERSION=MASVS-v2.1

# --- CORS / Frontend ---
# Not read directly — docker-compose.yml derives both of these from
# WEB_HOST_PORT / API_HOST_PORT above so they always agree with the actual
# ports in use. Left here only as a reference for running the backend or
# frontend outside Docker Compose.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
