# Copy this file to .env and adjust as needed.
# Docker Compose and the backend both read from .env at the repo root.

# --- Postgres ---
POSTGRES_USER=mastools
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mastools
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend ---
# Full SQLAlchemy URL is assembled from the Postgres vars above if left unset.
DATABASE_URL=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=500
CATALOG_VERSION=MASVS-v2.1

# --- CORS (frontend origin during local dev) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
